{
  "provider": "crypto_csv",
  "asset_id": "crypto:BTC-USD",
  "data_path": "data/crypto_statistics_data.csv",
  "artifacts_dir": "assets/runs",
  "end_date": "2025-10-14",
  "models": ["last_value", "drift", "seasonal_naive", "exponential_smoothing", "holt_winters", "arima", "sarima", "ridge", "lasso", "random_forest", "xgboost", "rnn", "lstm", "gru"],
  "horizons": [1, 5, 20],
  "folds": 3,
  "final_test_size": 20,
  "min_train_size": 100,
  "max_train_rows": 180,
  "seasonal_period": 7,
  "strategy": "recursive",
  "seed": 42,
  "model_params": {
    "holt_winters": {"seasonal_period": 7},
    "sarima": {"order": [1, 1, 0], "seasonal_order": [1, 0, 0, 7]},
    "ridge": {"lookback": 10, "alpha": 1.0},
    "lasso": {"lookback": 10, "alpha": 0.01},
    "random_forest": {"lookback": 10, "n_estimators": 20, "max_depth": 4},
    "xgboost": {"lookback": 10, "n_estimators": 20, "max_depth": 3, "learning_rate": 0.05},
    "rnn": {"lookback": 10, "hidden_size": 4, "epochs": 2, "batch_size": 32, "patience": 2},
    "lstm": {"lookback": 10, "hidden_size": 4, "epochs": 2, "batch_size": 32, "patience": 2},
    "gru": {"lookback": 10, "hidden_size": 4, "epochs": 2, "batch_size": 32, "patience": 2}
  }
}
